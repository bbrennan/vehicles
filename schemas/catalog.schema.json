            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "conditions": {
          "$ref": "#/$defs/Conditions"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "color",
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "enum": [
            "exterior",
            "interior"
