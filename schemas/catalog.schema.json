    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "exclusiveMinimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "final_url": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Final Url",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Media Type",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "id",
        "source",
        "retrieved_at",
        "final_url",
        "media_type",
        "sha256",
        "byte_count"
      ],
      "title": "Artifact",
      "type": "object"
    },
