    "Record": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "$ref": "#/$defs/Configuration"
        },
        "facts": {
          "items": {
            "discriminator": {
              "mapping": {
                "color": "#/$defs/ColorFact",
                "feature": "#/$defs/FeatureFact",
                "measurement": "#/$defs/MeasurementFact",
                "rating": "#/$defs/RatingFact",
                "specification": "#/$defs/SpecificationFact"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/FeatureFact"
              },
              {
                "$ref": "#/$defs/MeasurementFact"
              },
              {
                "$ref": "#/$defs/RatingFact"
              },
              {
                "$ref": "#/$defs/ColorFact"
              },
              {
                "$ref": "#/$defs/SpecificationFact"
              }
            ]
          },
          "title": "Facts",
          "type": "array"
        }
      },
      "required": [
        "configuration",
        "facts"
      ],
      "title": "Record",
      "type": "object"
