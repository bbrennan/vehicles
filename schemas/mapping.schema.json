    "Review": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rationale",
          "type": "string"
        },
        "reviewed_on": {
          "format": "date",
          "title": "Reviewed On",
          "type": "string"
        },
        "reviewer": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reviewer",
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "reviewed_on",
        "rationale",
        "evidence"
      ],
      "title": "Review",
      "type": "object"
    },
    "ReviewedFact": {
      "additionalProperties": false,
      "properties": {
        "configuration_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Configuration Id",
          "type": "string"
        },
        "fact": {
          "discriminator": {
            "mapping": {
              "color": "#/$defs/ColorFact",
              "feature": "#/$defs/FeatureFact",
              "measurement": "#/$defs/MeasurementFact",
              "rating": "#/$defs/RatingFact",
              "specification": "#/$defs/SpecificationFact"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FeatureFact"
            },
            {
              "$ref": "#/$defs/MeasurementFact"
            },
            {
              "$ref": "#/$defs/RatingFact"
            },
            {
              "$ref": "#/$defs/ColorFact"
            },
            {
              "$ref": "#/$defs/SpecificationFact"
            }
          ],
          "title": "Fact"
        },
        "review": {
          "$ref": "#/$defs/Review"
        }
      },
      "required": [
        "configuration_id",
        "fact",
        "review"
      ],
      "title": "ReviewedFact",
      "type": "object"
    },
    "SpecificationFact": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Attribute",
          "type": "string"
        },
        "conditions": {
          "$ref": "#/$defs/Conditions"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "specification",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "id",
        "evidence",
        "kind",
        "attribute",
        "value"
      ],
      "title": "SpecificationFact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assignments": {
      "items": {
        "$ref": "#/$defs/Assignment"
      },
      "title": "Assignments",
      "type": "array"
    },
    "configurations": {
      "items": {
        "$ref": "#/$defs/Configuration"
      },
      "title": "Configurations",
      "type": "array"
    },
    "coverage_notes": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Coverage Notes",
      "type": "array"
    },
    "feature_vocabulary": {
      "additionalProperties": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Feature Vocabulary",
      "type": "object"
    },
    "release_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Release Id",
      "type": "string"
    },
    "reviewed_facts": {
      "items": {
        "$ref": "#/$defs/ReviewedFact"
      },
      "title": "Reviewed Facts",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "specification_vocabulary": {
      "additionalProperties": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Specification Vocabulary",
      "type": "object"
    }
  },
  "required": [
    "release_id",
    "configurations",
    "feature_vocabulary",
    "coverage_notes"
  ],
  "title": "MappingPlan",
  "type": "object"
}
