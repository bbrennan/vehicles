      "type": "object"
    },
    "FeatureFact": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "enum": [
            "standard",
            "optional",
            "package",
            "unavailable"
          ],
          "title": "Availability",
          "type": "string"
        },
        "conditions": {
          "$ref": "#/$defs/Conditions"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "feature": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Feature",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "feature",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "evidence",
        "kind",
        "feature",
        "availability"
      ],
      "title": "FeatureFact",
      "type": "object"
    },
    "MeasurementFact": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Basis",
          "type": "string"
        },
        "conditions": {
          "$ref": "#/$defs/Conditions"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "fuel": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fuel"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "measurement",
          "title": "Kind",
          "type": "string"
        },
        "metric": {
          "enum": [
            "fuel_economy_city",
            "fuel_economy_highway",
            "fuel_economy_combined",
            "electric_range",
            "total_range",
            "electricity_consumption_combined",
            "length",
            "width",
            "height",
            "wheelbase",
            "cargo_volume",
            "towing_capacity",
            "payload",
            "seating_capacity",
            "battery_capacity",
            "charging_power",
            "charging_duration",
            "power",
            "torque",
            "msrp"
          ],
          "title": "Metric",
          "type": "string"
        },
        "unit": {
          "enum": [
            "mpg_us",
            "mpge_us",
            "L/100km",
            "mi",
            "km",
            "kWh/100mi",
            "kWh/100km",
            "mm",
            "in",
            "L",
            "ft3",
            "kg",
            "lb",
            "person",
            "kWh",
            "kW",
            "min",
            "hp",
            "Nm",
            "lb-ft",
            "USD",
            "CAD",
            "MXN"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "id",
        "evidence",
        "kind",
        "metric",
        "value",
        "unit",
        "basis"
      ],
      "title": "MeasurementFact",
      "type": "object"
    },
    "RatingFact": {
      "additionalProperties": false,
      "properties": {
        "agency": {
          "enum": [
            "NHTSA",
            "IIHS",
            "OTHER"
          ],
          "title": "Agency",
          "type": "string"
        },
        "conditions": {
          "$ref": "#/$defs/Conditions"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "rating",
          "title": "Kind",
          "type": "string"
        },
        "methodology": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Methodology",
          "type": "string"
        },
        "published_applicability": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Published Applicability",
          "type": "string"
        },
        "scale": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Scale",
          "type": "string"
        },
        "test": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Test",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "id",
        "evidence",
        "kind",
        "agency",
        "test",
        "methodology",
        "scale",
        "value",
        "published_applicability"
      ],
      "title": "RatingFact",
      "type": "object"
