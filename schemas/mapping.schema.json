{
  "$defs": {
    "Assignment": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Candidate Id",
          "type": "string"
        },
        "configuration_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Configuration Id",
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/Review"
        }
      },
      "required": [
        "candidate_id",
        "configuration_id",
        "review"
      ],
      "title": "Assignment",
      "type": "object"
    },
    "ColorFact": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "enum": [
            "standard",
            "optional",
            "package",
            "unavailable"
          ],
          "title": "Availability",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "conditions": {
          "$ref": "#/$defs/Conditions"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "color",
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "enum": [
            "exterior",
            "interior"
          ],
          "title": "Location",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "paired_color_codes": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Paired Color Codes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "evidence",
        "kind",
        "location",
        "name",
        "availability"
      ],
      "title": "ColorFact",
      "type": "object"
    },
    "Conditions": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "package_codes": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Package Codes",
          "type": "array"
        },
        "production_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Production From"
        },
        "production_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Production To"
        },
        "regions": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Regions",
          "type": "array"
        }
      },
      "title": "Conditions",
      "type": "object"
    },
    "Configuration": {
      "additionalProperties": false,
      "properties": {
        "battery": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Battery"
        },
        "bed": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bed"
        },
        "body_style": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Style"
        },
        "cab": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cab"
        },
        "drivetrain": {
          "anyOf": [
            {
              "enum": [
                "FWD",
                "RWD",
                "AWD",
                "4WD"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drivetrain"
        },
        "engine": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "generation": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "make": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Make",
          "type": "string"
        },
        "market": {
          "enum": [
            "US",
            "CA",
            "MX"
          ],
          "title": "Market",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Model",
          "type": "string"
        },
        "powertrain": {
          "anyOf": [
            {
              "enum": [
                "ICE",
                "HEV",
                "PHEV",
                "BEV",
                "FCEV"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Powertrain"
        },
        "transmission": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transmission"
        },
        "trim": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Trim",
          "type": "string"
        },
        "wheels": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wheels"
        },
        "year": {
          "maximum": 2200,
          "minimum": 1900,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "market",
        "year",
        "make",
        "model",
        "trim",
        "evidence"
      ],
      "title": "Configuration",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Artifact Id",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Locator",
          "type": "string"
        },
        "original_value": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Original Value",
          "type": "string"
        },
        "source_record_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Record Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "locator",
        "source_record_id",
        "original_value"
      ],
